# ==============================================================================
# GreenWave - Server Environment Configuration
# ==============================================================================
PORT=5000
NODE_ENV=production
CORS_ORIGIN=*
JWT_SECRET=greenwave_production_jwt_secret_change_me_super_secure_random_string_2025

# ==============================================================================
# Database Configuration (Enterprise MySQL / MariaDB / Cloud Relational Database)
# ==============================================================================
DB_TYPE=mysql

# Option A: Cloud Connection String (PlanetScale, AWS RDS, GCP Cloud SQL, Railway, Aiven)
# Format: mysql://user:password@host:port/database?ssl=true
DATABASE_URL=mysql://greenwave:GreenWave#2025@localhost:3306/greenwave_db

# Option B: Individual Connection Parameters
DB_HOST=localhost
DB_PORT=3306
DB_USER=greenwave
DB_PASSWORD=GreenWave#2025
DB_NAME=greenwave_db
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20

# Meta WhatsApp Cloud API v21.0
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=greenwave_verify_token_prod_99
META_APP_SECRET=

# Initial Seeds
INITIAL_ADMIN_EMAIL=admin@greenwave.io
INITIAL_ADMIN_PASSWORD=GreenWave#2025
