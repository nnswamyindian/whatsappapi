# ==============================================================================
# GreenWave - WhatsApp Business Messaging SaaS Platform Configuration
# Copy this file to .env or server/.env and fill in real production values.
# NEVER commit production .env files to version control!
# ==============================================================================

# Server Network Settings
PORT=5000   
NODE_ENV=production
CORS_ORIGIN=https://app.greenwave.io

# JWT Security (Must be at least 32 characters of cryptographically secure random bytes)
JWT_SECRET=your_production_jwt_signing_secret_here_min_32_chars

# Data Encryption at Rest (AES-256-GCM key for securing Meta access tokens and customer credentials)
ENCRYPTION_KEY=your_aes_256_encryption_key_32_characters_here

# Database Configuration (Built-in WAL mode SQLite or mountable persistent path)
DB_PATH=./data/greenwave.db

# ==============================================================================
# Meta WhatsApp Cloud API Configuration
# Configurable Graph API Version (e.g. v21.0, v22.0)
# ==============================================================================
META_API_VERSION=v21.0

# Meta App ID & Config ID (Required for Meta WhatsApp Embedded Signup v4 onboarding flow)
META_APP_ID=your_meta_facebook_app_id
META_CONFIG_ID=your_meta_embedded_signup_config_id

# Meta App Secret (Used to exchange Embedded Signup codes and verify X-Hub-Signature-256 on webhooks)
META_APP_SECRET=your_meta_app_secret_here

# Meta Webhook Verification Token (Configure in Meta App Dashboard > WhatsApp > Configuration)
META_WEBHOOK_VERIFY_TOKEN=your_secure_random_webhook_verify_token

# Administrative Default Fallback Credentials (Only used when manually testing without Embedded Signup)
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=

# ==============================================================================
# First-Run Platform Administrator Setup (Prompted securely on initial deployment)
# ==============================================================================
INITIAL_ADMIN_EMAIL=admin@greenwave.io
INITIAL_ADMIN_PASSWORD=your_secure_admin_password_setup_on_install

