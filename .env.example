# ==============================================================================
# GreenWave - WhatsApp Business Messaging SaaS Platform Configuration
# Copy this file to .env or server/.env and fill in real production values.
# NEVER commit production .env files to version control!
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=production
CORS_ORIGIN=*

# JWT Security
JWT_SECRET=greenwave_production_jwt_secret_change_me_super_secure_random_string_2025

# Database Configuration (Built-in WAL mode SQLite or mountable persistent path)
DB_PATH=./data/greenwave.db

# ==============================================================================
# Meta WhatsApp Cloud API (Graph API v21.0)
# Leave empty to run in labeled Sandbox / Mock mode with realistic async simulation.
# ==============================================================================
# Official Meta WhatsApp Business Account ID (WABA)
META_WABA_ID=

# Meta Phone Number ID registered under your WABA
META_PHONE_NUMBER_ID=

# Permanent Meta System User Access Token with 'whatsapp_business_messaging' and 'whatsapp_business_management' permissions
META_ACCESS_TOKEN=

# Secret token configured in Meta App Dashboard > WhatsApp > Configuration > Webhook Verify Token
META_WEBHOOK_VERIFY_TOKEN=greenwave_verify_token_prod_99

# Meta App Secret (used to verify X-Hub-Signature-256 on incoming webhook payloads)
META_APP_SECRET=

# ==============================================================================
# Default Platform Seeding
# ==============================================================================
INITIAL_ADMIN_EMAIL=admin@greenwave.io
INITIAL_ADMIN_PASSWORD=GreenWave#2025
